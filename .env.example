# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Banco PostgreSQL (usuário, senha, servidor, porta e nome do banco)
APISIGEDUC_BANCO_URL=postgresql://apisigeduc:SENHA_DO_BANCO@localhost:5432/apisigeduc

# Gere as duas linhas abaixo com: apisigeduc gerar-chave
# SIGEDUC_CHAVE cifra as senhas do SIGEduc no banco. Guarde uma cópia em local
# seguro: sem ela as senhas cadastradas não podem ser lidas.
SIGEDUC_CHAVE=
# Assina o cookie de login da tela web.
APISIGEDUC_SEGREDO_SESSAO=

# Média mínima para aprovação (rede estadual do RN: 6,0)
APISIGEDUC_MEDIA_MINIMA=6

# Carga diária para a SEEC/SIGEduc ("19:00"; vazio = só carga manual pelo administrador)
APISIGEDUC_JANELA_SINCRONIA=
# arquivo = gera o arquivo padronizado; sigeduc = lança as médias pelo robô
APISIGEDUC_MODO_SINCRONIA=arquivo

# O robô só CONSULTA o SIGEduc (turmas, estudantes, fotos): nunca grava nem apaga nada lá.
# Mudar para false só num SIGEduc de testes, nunca no real.
APISIGEDUC_SIGEDUC_SOMENTE_LEITURA=true

# Início de cada bimestre (mês-dia), para separar as aulas na tela da turma
APISIGEDUC_BIMESTRES=02-01,05-04,08-01,10-13

SIGEDUC_URL=https://sigeduc.rn.gov.br/sigeduc
# true = navegador invisível; false = abre a janela (útil para mapear seletores)
SIGEDUC_HEADLESS=true
# O SIGEduc pode pedir uma verificação humana ("não sou um robô") no login. Com o
# navegador visível, o programa espera uma pessoa resolvê-la por até N segundos.
SIGEDUC_ESPERA_VERIFICACAO_S=300
# Tempo máximo de espera por elemento, em milissegundos
SIGEDUC_TIMEOUT_MS=30000
# Pausa entre registros, em milissegundos, para não sobrecarregar o sistema
SIGEDUC_PAUSA_MS=500
