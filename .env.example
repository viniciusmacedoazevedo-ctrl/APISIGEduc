# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Banco PostgreSQL (usuário, senha, servidor, porta e nome do banco)
APISIGEDUC_BANCO_URL=postgresql://apisigeduc:SENHA_DO_BANCO@localhost:5432/apisigeduc

# Gere as duas linhas abaixo com: apisigeduc gerar-chave
# SIGEDUC_CHAVE cifra as senhas do SIGEduc no banco. Guarde uma cópia em local
# seguro: sem ela as senhas cadastradas não podem ser lidas.
SIGEDUC_CHAVE=
# Assina o cookie de login da tela web.
APISIGEDUC_SEGREDO_SESSAO=

SIGEDUC_URL=https://sigeduc.rn.gov.br/sigeduc
# true = navegador invisível; false = abre a janela (útil para mapear seletores)
SIGEDUC_HEADLESS=true
# Tempo máximo de espera por elemento, em milissegundos
SIGEDUC_TIMEOUT_MS=30000
# Pausa entre registros, em milissegundos, para não sobrecarregar o sistema
SIGEDUC_PAUSA_MS=500
